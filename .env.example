# ==============================================================================
# STAAZY — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend code or VITE_* variables.

# --- Supabase (Mandatory Frontend Client Configuration) ---
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# --- Third-Party Integrations (Optional — Configured When Activating) ---
VITE_GOOGLE_MAPS_API_KEY=""
VITE_WHATSAPP_BUSINESS_PHONE_NUMBER_ID=""
VITE_APP_URL="http://localhost:3000"

# --- Server-Side Secrets ONLY (Never prefix with VITE_) ---
# Used only in server-side Edge Functions / API routes, never in browser code.
SUPABASE_SERVICE_ROLE_KEY=""
WHATSAPP_BUSINESS_ACCESS_TOKEN=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
